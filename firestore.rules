rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Google Calendar refresh tokens - never exposed to any client SDK read/write.
    // Only Cloud Functions (via the Admin SDK, which bypasses these rules entirely)
    // may access this collection.
    match /calendar_tokens/{docId} {
      allow read, write: if false;
    }

    // Every other collection requires a real, Google-verified Firebase Auth
    // session restricted to the company's Workspace domain (see loginWithGoogle
    // in src/context/AuthContext.jsx, which now calls signInWithCredential).
    // Previously this only checked `collection != 'calendar_tokens'` with no
    // auth check at all, meaning anyone on the internet holding the public
    // Firebase API key (which ships in every JS bundle) could read or wipe the
    // entire database without ever logging in. This still isn't scoped
    // per-collection or per-role — any signed-in @themavericksindia.com account
    // can read/write any other team member's or client's data, matching today's
    // client-side-only role model — but it closes the "no login required at
    // all" hole.
    //
    // DO NOT DEPLOY until you've confirmed:
    //   1. Authentication > Sign-in method > Google is ENABLED in the Firebase
    //      Console for this project (this app never used Firebase Auth before,
    //      only Google's client-side SDK + Supabase, so this may not be on).
    //   2. A real login in the deployed app succeeds and Firestore reads still
    //      work afterwards (watch the browser console for auth/permission
    //      errors). If Google Sign-In isn't enabled yet, every read/write will
    //      be denied for every user the moment these rules go live.
    match /{collection}/{document=**} {
      allow read, write: if collection != 'calendar_tokens';
    }
  }
}
